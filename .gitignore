# WordPress core and runtime state
/*
!/.gitignore
!/.env.example
!/docker-compose.yml
!/docker/
!/docker/**
!/Makefile
!/README.md
!/PLAN.md
!/GECMIS.md
!/composer.json
!/composer.lock
!/phpcs.xml.dist
!/.github/
!/.github/**
!/docs/
!/docs/**
!/scripts/
!/scripts/**
!/wp-content/

# Only project-owned WordPress code is versioned.
/wp-content/*
!/wp-content/themes/
!/wp-content/plugins/
/wp-content/themes/*
!/wp-content/themes/kuka-island-child/
!/wp-content/themes/kuka-island-child/**
/wp-content/plugins/*
!/wp-content/plugins/kuka-island-core/
!/wp-content/plugins/kuka-island-core/**

# Local secrets, media, database and generated files
.env
seed-media/
dist-deploy/
wp-content/uploads/
*.sql
*.sql.gz
.DS_Store

# EDM test credentials must never be committed. The canonical location is
# ~/.config/kuka-island/edm-test.env, which is outside this work tree and
# therefore unreachable by `git add`. These patterns only defend against an
# accidental in-repository copy, and are placed after the scripts/ allow-list
# so the last matching rule wins.
edm-test.env
.edm-test.env
*.edm-test.env
scripts/edm-test.env
scripts/*.edm-test.env
*edm-credentials*
