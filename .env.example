# Copy is generated automatically by `make install`; values stay local.
COMPOSE_PROJECT_NAME= # Docker project name
WP_PORT= # Local HTTP port
DB_NAME= # MariaDB database name
DB_USER= # MariaDB application user
DB_PASSWORD= # Generated local database password
DB_ROOT_PASSWORD= # Generated local root password
WP_URL= # Local WordPress URL
WP_TITLE= # WordPress site title
WP_ADMIN_USER= # Local administrator username
WP_ADMIN_PASSWORD= # Generated local administrator password
WP_ADMIN_EMAIL= # Local administrator email

# Production-only wp-config.php constant names (do not put their values here):
# KUKA_SMTP_HOST, KUKA_SMTP_PORT, KUKA_SMTP_USERNAME, KUKA_SMTP_PASSWORD
# KUKA_SMTP_ENCRYPTION, KUKA_SMTP_FROM_NAME
# KUKA_SMTP_REPLY_TO_EMAIL, KUKA_SMTP_REPLY_TO_NAME
WP_MANAGER_PASSWORD= # Separate generated Shop Manager password
